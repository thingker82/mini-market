rules_version = '2';

// 키즈나눔마켓 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 통째로 붙여넣고 "게시"를 누르세요.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validNewItem(d) {
      return d.keys().hasOnly(['type', 'title', 'cat', 'age', 'cond', 'price', 'desc', 'town', 'method',
                               'photo', 'ownerId', 'ownerName', 'status', 'receiverId', 'receiverName',
                               'applicants', 'createdAt'])
        && d.ownerId == me()
        && d.status == 'open'
        && d.receiverId == null
        && d.receiverName == null
        && d.applicants == {}
        && d.cat in ['toy', 'book', 'cloth', 'gear', 'baby', 'ride']
        && d.age in ['0~1세', '1~3세', '4~7세', '8세 이상']
        && d.cond in ['거의 새것', '깨끗해요', '사용감 있음']
        && d.method in ['직거래', '무인함 (준비중)', '문고리 거래']
        && d.createdAt == request.time
        && d.type in ['free', 'donate', 'cheap']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.desc is string && d.desc.size() <= 300
        && d.town is string && d.town.size() > 0 && d.town.size() <= 15
        && d.ownerName is string && d.ownerName.size() <= 20
        && d.price is number
        && ((d.type == 'cheap' && d.price >= 0 && d.price <= 100000) || (d.type != 'cheap' && d.price == 0))
        && d.photo is string && d.photo.size() < 400000
        && (d.photo == '' || d.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'));
    }
    // 신청: 내 uid 하나만 applicants 에 추가
    function isApply() {
      let added = request.resource.data.applicants.diff(resource.data.applicants);
      return resource.data.ownerId != me()
        && resource.data.status == 'open'
        && changedOnly(['applicants'])
        && added.addedKeys().hasOnly([me()]) && added.addedKeys().size() == 1
        && added.removedKeys().size() == 0 && added.changedKeys().size() == 0
        && request.resource.data.applicants[me()] is string
        && request.resource.data.applicants[me()].size() <= 20;
    }
    // 주인이 신청자 중 한 명을 받는 사람으로 정함
    function isChoose() {
      return resource.data.ownerId == me()
        && resource.data.status == 'open'
        && request.resource.data.status == 'reserved'
        && request.resource.data.receiverId in resource.data.applicants
        && request.resource.data.receiverName == resource.data.applicants[request.resource.data.receiverId]
        && changedOnly(['status', 'receiverId', 'receiverName']);
    }
    // 주인이 예약을 취소
    function isCancel() {
      return resource.data.ownerId == me()
        && resource.data.status == 'reserved'
        && request.resource.data.status == 'open'
        && request.resource.data.receiverId == null
        && request.resource.data.receiverName == null
        && changedOnly(['status', 'receiverId', 'receiverName']);
    }
    // 받은 사람이 "받았어요"를 눌러야 거래 완료 (이때 주인에게 점수가 생김)
    function isDone() {
      return resource.data.receiverId == me()
        && resource.data.status == 'reserved'
        && request.resource.data.status == 'done'
        && changedOnly(['status']);
    }

    match /items/{itemId} {
      allow read: if true;
      allow create: if signedIn() && validNewItem(request.resource.data);
      allow update: if signedIn() && (isApply() || isChoose() || isCancel() || isDone());
      allow delete: if signedIn() && resource.data.ownerId == me() && resource.data.status == 'open';

      // 주인과 받는 사람만 볼 수 있는 대화
      match /messages/{msgId} {
        function item() { return get(/databases/$(db)/documents/items/$(itemId)).data; }
        function member() { return item().ownerId == me() || item().receiverId == me(); }
        allow read: if signedIn() && member();
        allow create: if signedIn() && member()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == me()
          && request.resource.data.name is string && request.resource.data.name.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
